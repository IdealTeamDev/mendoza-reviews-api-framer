# ID del cliente OAuth creado en Google Cloud.
GOOGLE_CLIENT_ID="pegar-id-de-cliente-oauth"

# Secreto del cliente OAuth. No subir el valor real a GitHub.
GOOGLE_CLIENT_SECRET="pegar-secreto-del-cliente"

# Refresh token generado en OAuth Playground con el scope business.manage.
GOOGLE_REFRESH_TOKEN="pegar-refresh-token"

# Identificador completo de la ficha de Google Business Profile.
GBP_LOCATION_NAME="accounts/123456789/locations/987654321"

# Clave privada para ejecutar /api/sync manualmente.
CRON_SECRET="elegir-clave-segura"

# Durante pruebas puede ser "*"; en produccion se puede limitar al dominio de Framer.
ALLOWED_ORIGIN="*"

# Opcional: Vercel lo crea al activar Blob Storage.
BLOB_READ_WRITE_TOKEN=""
